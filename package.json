    "cli-spinners": "^3.4.0",
    "effect": "4.0.0-rc.111",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "web-tree-sitter": "0.25.10",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "eslint": "9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
