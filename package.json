    "@effect/platform-bun": "^0.91.0",
    "@napi-rs/keyring": "^1.3.0",
    "effect": "^3.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
